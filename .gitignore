# ============================================================
# 공통
# ============================================================
# OS 부산물
.DS_Store
Thumbs.db
desktop.ini

# 이 저장소를 연 에디터의 프로젝트 파일 (루트만)
/.idea/
/.vscode/

# 환경변수 / 로그
.env
.env.*
*.log

# ============================================================
# Paseo
# ============================================================
# 허용 목록 방식: 명시한 파일만 추적
paseo/*
!paseo/config.json
!paseo/desktop-settings.json

# 비밀값 / 기기별 파일 (어느 경로에 있든 차단)
daemon-keypair.json
local-credential
server-id
cli-client-id
paseo.pid
